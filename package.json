    "auth": "node dist/index.js auth"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.8.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@modelcontextprotocol/sdk": "^1.0.1",

  "description": "A Model Context Protocol server for Google Tasks — read and write task lists from Claude.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "gtasks-mcp": "dist/index.js"
  },
